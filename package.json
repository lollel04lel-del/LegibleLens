{
  "name": "legiblelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "prepare": "node scripts/prepare-ocr.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test",
    "start": "node scripts/prepare-ocr.mjs && node scripts/build.mjs && node server.mjs",
    "android:sync": "node scripts/prepare-ocr.mjs && node scripts/build.mjs && cap sync android",
    "android:build": "pnpm android:sync && node scripts/build-android.mjs",
    "extension:build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
