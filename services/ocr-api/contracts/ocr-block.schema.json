{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legiblelens.local/schemas/ocr-block.json",
  "title": "LegibleLens OCR block",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "box", "orientation", "readingOrder"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "correctedText": { "type": "string" },
    "mongolianTranslation": { "type": "string" },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "orientation": { "enum": ["horizontal", "vertical", "unknown"] },
    "readingOrder": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
