{
  "manifest_version": 3,
  "name": "LegibleLens",
  "version": "0.1.0",
  "description": "Capture the visible tab, OCR Japanese text, and open a Mongolian popup dictionary.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Capture this tab with LegibleLens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
